{
  "manifest_version": 3,
  "name": "Ferocity Facebook Connector",
  "version": "0.1.0",
  "description": "Tenant-isolated connector that brings loaded Facebook and Messenger conversations into Ferocity.",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://m.facebook.com/*",
    "https://www.messenger.com/*",
    "https://ferocity.live/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://m.facebook.com/*",
        "https://www.messenger.com/*"
      ],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "src/options.html",
  "action": {
    "default_title": "Ferocity Facebook Connector",
    "default_popup": "src/popup.html"
  }
}
