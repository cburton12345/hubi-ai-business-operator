DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"
# Base64-encoded Supabase project CA certificate. Production uses it to verify the database host.
DATABASE_CA_CERT_BASE64=""
# Keep each serverless instance from opening an unbounded number of database connections.
DATABASE_POOL_MAX="3"
MCP_ALLOWED_HOSTS="api.ferocity.live,ferocity.live"
