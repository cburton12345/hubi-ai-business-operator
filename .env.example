CREDENTIAL_ENCRYPTION_KEY="CHANGE_ME_TO_A_LONG_RANDOM_SECRET_FOR_BYO_PROVIDER_KEYS"
# Temporary only during a controlled credential-vault rotation. Remove after every record is re-encrypted and verified.
CREDENTIAL_ENCRYPTION_KEY_PREVIOUS=""
SECURITY_HMAC_KEY="CHANGE_ME_TO_A_SEPARATE_LONG_RANDOM_SECRET_FOR_PSEUDONYMOUS_SECURITY_TOKENS"
AI_PROVIDER="openai"
AI_MODEL="gpt-4.1-mini"
# Optional behavior-preserving routing lanes. Leave blank until representative
# workflow evaluations prove a cheaper or stronger model meets the quality bar.
AI_MODEL_ECONOMY=""
AI_MODEL_BALANCED=""
AI_MODEL_ADVANCED=""
AI_VISION_MODEL=""
# Emergency price overrides. Normal accounting uses the built-in per-model table.
AI_CACHED_INPUT_USD_PER_MILLION=""
OPENAI_API_KEY=""
# Per-instance concurrency guard; excess requests use the safe workflow fallback.
AI_MAX_CONCURRENT_REQUESTS="6"
# Background automation uses a durable 15-minute worker. Keep tenant work bounded per run.
AUTOMATION_TENANT_BATCH_SIZE="50"
AUTOMATION_AGENT_BATCH_SIZE="50"
AUTOMATION_TENANT_CONCURRENCY="2"
# Optional platform-capacity alert thresholds. Defaults shown are conservative launch values.
CAPACITY_DUE_ACTIONS_WATCH="500"
CAPACITY_DUE_ACTIONS_HIGH="2000"
CAPACITY_DUE_ACTIONS_CRITICAL="10000"
CAPACITY_FAILED_ACTIONS_WATCH="10"
CAPACITY_FAILED_ACTIONS_HIGH="50"
CAPACITY_FAILED_ACTIONS_CRITICAL="200"
CAPACITY_RECENT_ERRORS_WATCH="10"
CAPACITY_RECENT_ERRORS_HIGH="50"
CAPACITY_RECENT_ERRORS_CRITICAL="200"
