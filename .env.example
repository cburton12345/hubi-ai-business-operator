SECURITY_HMAC_KEY="CHANGE_ME_TO_A_SEPARATE_LONG_RANDOM_SECRET_FOR_PSEUDONYMOUS_SECURITY_TOKENS"
AI_PROVIDER="openai"
AI_MODEL="gpt-4.1-mini"
FEROCITY_COMMAND_PLANNING_TIMEOUT_MS="22000"
# Optional behavior-preserving routing lanes. Leave blank until representative
# workflow evaluations prove a cheaper or stronger model meets the quality bar.
AI_MODEL_ECONOMY=""
AI_MODEL_BALANCED=""
# Frontier lane for infrequent, consequential reasoning. GPT-6 Astra is not
# used for routine chat/OCR; enable only after representative evals pass.
AI_MODEL_ADVANCED="gpt-6-astra"
AI_MODEL_REVIEWER=""
AI_MODEL_STATEMENT_REVIEWER=""
AI_STATEMENT_CLASSIFICATION_REVIEW_MAX_ROWS_PER_DOCUMENT="10"
AI_REASONING_EFFORT_ADVANCED="low"
AI_VISION_MODEL=""
# Emergency price overrides. Normal accounting uses the built-in per-model table.
AI_CACHED_INPUT_USD_PER_MILLION=""
OPENAI_API_KEY=""
# Per-instance concurrency guard; excess requests use the safe workflow fallback.
AI_MAX_CONCURRENT_REQUESTS="6"
# Background automation uses a durable 15-minute worker. Keep tenant work bounded per run.
AUTOMATION_TENANT_BATCH_SIZE="50"
AUTOMATION_AGENT_BATCH_SIZE="50"
AUTOMATION_TENANT_CONCURRENCY="2"
# Per-workspace persistent-outcome throughput. Planning stays below the global AI concurrency guard.
AUTOMATION_GOAL_PLAN_BATCH_SIZE="8"
AUTOMATION_GOAL_PLANNING_CONCURRENCY="2"
AUTOMATION_GOAL_STEP_BATCH_SIZE="50"
