{
  "apiBase": "https://ferocity.live/api/integrations/facebook-connector",
  "deviceId": "provided-by-secret-environment",
  "deviceName": "Hosted Chris Burton recruiting worker",
  "runtime": "hosted_worker",
  "automationEnabled": true,
  "sendEnabled": false,
  "communityDiscoveryEnabled": true,
  "killSwitchFile": "PAUSE",
  "identity": { "expectedProfileId": "61593739891634" },
  "browser": {
