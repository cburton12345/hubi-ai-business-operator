FEROCITY_CONNECTOR_RUNTIME=hosted_worker
FEROCITY_CONNECTOR_API_BASE=https://ferocity.live/api/integrations/facebook-connector
FEROCITY_WORKER_ROOT=/var/lib/ferocity-marketplace-worker
FEROCITY_FACEBOOK_DEVICE_ID=replace-with-paired-device-id
FEROCITY_FACEBOOK_DEVICE_NAME=Hosted Chris Burton recruiting worker
FEROCITY_FACEBOOK_PROFILE_ID=61593739891634
FEROCITY_FACEBOOK_AUTOMATION_ENABLED=true
FEROCITY_FACEBOOK_SEND_ENABLED=false
FEROCITY_FACEBOOK_DISCOVERY_ENABLED=true
FEROCITY_FACEBOOK_HEADLESS=false
FEROCITY_FACEBOOK_PROFILE_DIR=.facebook-profile
FEROCITY_FACEBOOK_KILL_SWITCH_FILE=PAUSE
FEROCITY_CONNECTOR_TOKEN=replace-through-host-secret-manager
DISPLAY=:0
XAUTHORITY=/var/lib/ferocity-marketplace-worker/.Xauthority
