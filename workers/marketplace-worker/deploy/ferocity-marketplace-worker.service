[Unit]
Description=Ferocity hosted Marketplace recruiting worker
After=network-online.target graphical-session.target
Wants=network-online.target

[Service]
Type=simple
User=ferocity-worker
Group=ferocity-worker
WorkingDirectory=/opt/ferocity-marketplace-worker
EnvironmentFile=/etc/ferocity-marketplace-worker/worker.env
Environment=NODE_ENV=production
Environment=HOME=/var/lib/ferocity-marketplace-worker
Environment=XDG_CONFIG_HOME=/var/lib/ferocity-marketplace-worker/.config
Environment=XDG_CACHE_HOME=/var/lib/ferocity-marketplace-worker/.cache
ExecStart=/usr/bin/npm run start:hosted
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ferocity-marketplace-worker
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false

[Install]
WantedBy=graphical.target
