{
  "name": "ferocity-ai-business-operator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "db:bootstrap-admin": "node scripts/bootstrap-admin.mjs",
    "db:migrate": "node scripts/run-migrations.mjs",
    "db:verify-rls": "node scripts/verify-rls.mjs",
    "beta:smoke": "node scripts/beta-smoke.mjs",
    "prod:check": "node scripts/production-readiness-check.mjs",
    "provider:check": "node scripts/provider-readiness.mjs",
    "customer:path:smoke": "node scripts/customer-path-smoke.mjs",
    "public:guard": "node scripts/check-public-company-leaks.mjs",
    "predeploy:local": "npm run public:guard && npm run typecheck && npm run lint && npm run build",
    "launch:smoke": "node scripts/launch-smoke.mjs",
    "owner:smoke": "node scripts/smoke-owner-event.mjs",
    "owner:smoke:4bid": "node scripts/smoke-4bid-owner-event.mjs",
    "owner:smoke:marketplacepro": "node scripts/smoke-owner-event.mjs marketplacepro",
    "owner:smoke:guardiansignal": "node scripts/smoke-owner-event.mjs guardiansignal",
    "owner:smoke:bidops": "node scripts/smoke-owner-event.mjs bidops",
    "labor:smoke": "node scripts/smoke-labor-owner-event.mjs && node scripts/smoke-worker-intake-insert.mjs",
